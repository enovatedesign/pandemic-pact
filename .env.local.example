# Craft CMS GraphQL API
CONTENT_API_URL="https://pandemic-pact-cms.test/api/"
CONTENT_API_TOKEN=""
REVALIDATE_API_TOKEN=""

# OpenSearch
SEARCH_HOST=""
SEARCH_USERNAME=""
SEARCH_PASSWORD=""
SEARCH_INDEX_PREFIX=""
# Optional version suffix appended to the index name (e.g. "v2" -> "grants-v2").
# Use to build a parallel index with updated mappings, then promote to
# production by setting the same value in the production environment.
SEARCH_INDEX_VERSION=""

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=""

# Vercel KV — backs the "share these filters" links on the visualise and explore
# pages. Without it those links resolve to nothing; the rest of the site is fine.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Development
NODE_TLS_REJECT_UNAUTHORIZED=0
#
# Every switch below (and every FORCE_*/SKIP_*/USE_* further down) is compared
# strictly against the string `true`, so `=false` turns one off as you'd expect.
SKIP_OPENSEARCH_INDEXING=true
SKIP_FETCHING_PUBMED_DATA=true
# Force a re-fetch of every grant's PubMed data, ignoring the 7-day freshness window
FETCH_PUBMED_DATA=false
# Audit and repair individual PubMed object files during the fetch
PUBMED_JSON_AUDIT=false

# Grant data storage: Amazon S3 + CloudFront
AWS_REGION="eu-west-2"
S3_BUCKET="pandemicpact-data"
# CloudFront base (custom domain)
ASSET_BASE_URL="https://pandemicpact.edcdn.com"
# For cache invalidation of changed objects
CLOUDFRONT_DISTRIBUTION_ID=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Read grant/PubMed data from the CDN (prod/preview) vs local public/ files (dev)
USE_REMOTE_STORAGE=false
# Force an upload to S3 even outside a Vercel build (local testing)
FORCE_UPLOAD=false
# Force a full generate even when the Figshare file ID matches the S3 marker.
# No branch guard in CI — see the README before setting this there.
FORCE_FULL_GENERATE=false
# Skip the post-generate checks on the artefacts the frontend fetches at runtime.
# Only for a local generate you deliberately ran without a dataset.
SKIP_ARTEFACT_VERIFICATION=false

# FigShare Personal Access Token — required by `npm run generate`, which throws
# without it. Clinical-trials generation self-skips rather than throwing, so a
# missing token shows up as both CT pages 404ing their data.
FIGSHARE_PA_TOKEN=""

# Testing
# Deployment the smoke checks run against. Playwright defaults to
# http://localhost:3000, so a local `npm run test:e2e` needs neither of these.
SMOKE_BASE_URL=""
# Skip waiting for a new build to go live before smoke testing — always set this
# for a local run, otherwise the script polls for up to 12 minutes.
SKIP_DEPLOYMENT_WAIT=true
